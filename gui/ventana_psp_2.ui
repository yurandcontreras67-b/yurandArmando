   <string notr="true">QDialog {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0f172a,
        stop:1 #1e1b4b
    );
}

/* Etiquetas generales */
QLabel {
    color: #7dd3fc;
    font-size: 13px;
    font-weight: 500;
}

/* Campos de texto */
QLineEdit {
    background-color: #020617;
    border: 2px solid #38bdf8;
    border-radius: 10px;
    padding: 6px;
    color: #e2e8f0;
    selection-background-color: #38bdf8;
    selection-color: black;
}

QLineEdit:focus {
    border: 2px solid #a78bfa;
    background-color: #020617;
}

/* Botones */
QPushButton {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #a78bfa,
        stop:1 #6366f1
    );
    color: white;
    border-radius: 12px;
    padding: 8px;
    font-weight: bold;
    border: none;
}

QPushButton:hover {
    background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #c4b5fd,
        stop:1 #8b5cf6
    );
}

QPushButton:pressed {
    background-color: #4f46e5;
}

/* Labels destacados */
QLabel#label_B0,
QLabel#label_B1,
QLabel#label_r,
QLabel#label_r2,
QLabel#label_yk {
    background-color: #020617;
    border: 2px solid #38bdf8;
    border-radius: 8px;
    padding: 6px;
    color: #fde047;
    font-weight: bold;
    font-size: 13px;
}

/* Efecto tipo &quot;tarjeta&quot; */
QLabel#label_B0:hover,
QLabel#label_B1:hover,
QLabel#label_r:hover,
QLabel#label_r2:hover,
QLabel#label_yk:hover {
    border: 2px solid #a78bfa;
    background-color: #0f172a;
}</string>
