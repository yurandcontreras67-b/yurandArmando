   <string notr="true">QMainWindow {
background: qlineargradient(
spread:pad,
x1:0, y1:0, x2:1, y2:1,
stop:0 #ecfdf5,
stop:1 #d1fae5
);
}

/* Etiquetas generales */
QLabel {
color: #065f46;
font-size: 13px;
font-weight: 500;
}

/* Campos de texto */
QLineEdit {
background-color: #ffffff;
border: 2px solid #10b981;
border-radius: 10px;
padding: 6px;
color: #064e3b;
selection-background-color: #10b981;
selection-color: black;
}

QLineEdit:focus {
border: 2px solid #34d399;
background-color: #ffffff;
}

/* Botones */
QPushButton {
background: qlineargradient(
spread:pad,
x1:0, y1:0, x2:1, y2:0,
stop:0 #34d399,
stop:1 #059669
);
color: white;
border-radius: 12px;
padding: 8px;
font-weight: bold;
border: none;
}

QPushButton:hover {
background: qlineargradient(
spread:pad,
x1:0, y1:0, x2:1, y2:0,
stop:0 #6ee7b7,
stop:1 #10b981
);
}

QPushButton:pressed {
background-color: #047857;
}

/* Labels destacados */
QLabel#label_B0,
QLabel#label_B1,
QLabel#label_r,
QLabel#label_r2,
QLabel#label_yk {
background-color: #ffffff;
border: 2px solid #10b981;
border-radius: 8px;
padding: 6px;
color: #065f46;
font-weight: bold;
font-size: 13px;
}

/* Hover tipo tarjeta */
QLabel#label_B0:hover,
QLabel#label_B1:hover,
QLabel#label_r:hover,
QLabel#label_r2:hover,
QLabel#label_yk:hover {
border: 2px solid #34d399;
background-color: #d1fae5;
}
</string>
